# Two files hold settings. Neither is committed. This file is only a template: never put real keys here.
#
# 1) Repo root: copy this file to `.env` (Copy-Item .env.example .env). Read by the BACKEND.
#    Real values go in `.env`, never in `.env.example`.
# 2) frontend/.env.local: only the NEXT_PUBLIC_* lines below. Read by the FRONTEND (the browser can see
#    these, so they must never hold a secret).

# ---- backend: put in `.env` (repo root) ----
GEMINI_API_KEY=
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_STRONG=gemini-3.5-flash
# Full project URL, e.g. https://abcdefgh.supabase.co  (not just the project id). The app stops at
# startup with a clear error if this is not a full https URL.
SUPABASE_URL=
# Server-side secret key (starts with sb_secret_). Backend only, never in the frontend.
SUPABASE_SECRET_KEY=
# JWT secret not needed: tokens are verified with the project public keys (JWKS)
# Optional. Supabase Postgres connection string (Project settings > Database). If set, chat state is
# kept in Postgres and a conversation survives a backend restart; if empty, state is in memory only.
DATABASE_URL=
DAILY_TOKEN_BUDGET=200000
FRESHNESS_DAYS=90

# ---- frontend: put in `frontend/.env.local` ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Same full URL as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=
# Public key (starts with sb_publishable_). Safe for the browser. Do NOT use the secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
